    "floodWindowSeconds": 10,
    "floodMessageCount": 8,
    "adWhitelist": [
      "toolrise.space",
      "toolrise.ru",
      "vk.com/toolrise",
      "discord.gg/toolrise",
      "t.me/toolrise"
    ]
  },

