  "rules": [
    {
      "id": "2.0",
      "name": "Капс / спам / флуд / попрошайничество",
      "description": "Запрещены сообщения типа: капс, спам, флуд, попрошайничество. Флуд = 4 и более одинаковых сообщений за минуту (settings.spamRepeatCount / spamWindowSeconds)",
      "mute": "10m",
      "enabled": true,
      "phrases": ["@begging"],
      "detectors": ["CAPS", "SPAM_REPEAT"]
    },
    {
      "id": "2.1",
      "name": "Оскорбления",
      "description": "Запрещено унижение и грубые высказывания в адрес игроков",
      "mute": "30m",
      "enabled": true,
      "phrases": ["@insults"]
    },
    {
      "id": "2.2",
      "name": "Оскорбление администрации",
      "description": "Запрещено оскорблять/унижать представителей администрации",
      "mute": "4h",
      "enabled": true,
      "combos": [
        { "a": ["@staffRoles", "@staffNicks"], "b": ["@insults", "@profanity"] }
      ]
    },
    {
      "id": "2.3",
      "name": "Негатив о сервере",
      "description": "Запрещены негативные высказывания о сервере и разработке",
      "mute": "7d",
      "enabled": true,
      "combos": [
        { "a": ["@serverWords"], "b": ["@insults", "@profanity"] }
      ]
    },
    {
      "id": "2.4",
      "name": "Оскорбление родных / близких",
      "description": "Запрещено упоминание родных/близких в оскорбительном виде",
      "mute": "4h",
      "enabled": true,
      "phrases": [
        "мать в канаве",
        "батя в канаве",
        "мать уже в могиле",
        "батя уже в могиле",
        "мать в могиле",
        "батя в могиле",
        "че маме",
        "че папе",
        "безмамный",
        "безбати",
        "безбатьковщина",
        "re:я\\s*тво[юе]\\s*(мам\\w*|мат\\w*|бат\\w*|отц\\w*|пап\\w*)\\s*[еeё]б",
        "re:я\\s*тво[юе]\\s*(мам\\w*|мат\\w*|бат\\w*|отц\\w*|пап\\w*)\\s*на\\s*х[уy][еi]",
        "re:привет\\w{0,2}\\s*(мам\\w*|мат\\w*|бат\\w*|пап\\w*)\\b"
      ],
      "combos": [
        { "a": ["@family"], "b": ["@insults", "@profanity"] }
      ]
    },
    {
      "id": "2.5",
      "name": "Реклама своих каналов",
      "description": "Запрещена реклама своих каналов без привилегии/разрешения",
      "mute": "1h",
      "enabled": true,
      "detectors": ["AD_OWN_CHANNEL"]
    },
    {
      "id": "2.6",
      "name": "Расизм / нацизм",
      "description": "Запрещены любые проявления расизма, нацизма и подобного",
      "mute": "4h",
      "enabled": true,
      "phrases": ["@racism"]
    },
    {
      "id": "2.7",
      "name": "Реклама сторонних проектов",
      "description": "Запрещена реклама сторонних серверов/проектов",
      "mute": "permanent",
      "enabled": true,
      "detectors": ["AD_THIRD_PARTY"]
    },
    {
      "id": "2.8",
      "name": "Повторяющиеся символы",
      "description": "Запрещено злоупотребление повторяющимися символами/буквами/знаками (8 и более подряд)",
      "mute": "15m",
      "enabled": true,
      "detectors": ["REPEAT_CHARS"]
    },
    {
      "id": "2.9",
      "name": "Нецензурная лексика",
      "description": "Запрещены нецензурная брань, вульгарные выражения, аморальное поведение. По решению модерации наказывается от 6 матов в одном сообщении — одиночный мат без адресата не наказывается",
      "mute": "15m",
      "enabled": true,
      "minMatches": 6,
      "phrases": ["@profanity"]
    },
    {
      "id": "2.10",
      "name": "Организация флуда",
      "description": "Запрещена организация флуда в чате. FLOOD_RATE — не определение флуда проекта (оно в 2.0), а отдельный детектор быстрого потока РАЗНЫХ сообщений. Не нужен — поставь enabled: false",
      "mute": "15m",
      "enabled": true,
      "detectors": ["FLOOD_RATE"]
    }
  ]
